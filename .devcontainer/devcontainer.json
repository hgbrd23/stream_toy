{
  "name": "Claude Code Python Development",
  "build": {
    "dockerfile": "ilx-claude-code/Dockerfile",
    "context": "ilx-claude-code/"
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",

  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/.home,target=/home/ubuntu,type=bind"
  ],

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/workspace/.claude-profile",
  },

  "customizations": {
    "jetbrains": {
      "backend": "PyCharm",
      "plugins": [
        "com.intellij.clion",
        "Docker"
      ]
    }
  },

  "runArgs": ["--name", "magicbox_dev"],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "[ -f /home/ubuntu/.netrc ] && chmod 700 /home/ubuntu/.netrc; nohup socat TCP-LISTEN:9222,bind=127.0.0.1,fork,reuseaddr TCP:host.docker.internal:9222 >/tmp/chrome-devtools-bridge.log 2>&1 &",
  "remoteUser": "ubuntu",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
  }
}