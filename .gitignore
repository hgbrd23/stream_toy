# Python
__pycache__/
*.pyc

# Virtual environments
.venv/
.venv-emulator/

# Test artifacts
/tests/artifacts/
/tests/artifacts/**

# OS junk
.DS_Store
Thumbs.db
/.claude/
/.claude-profile/
/data/cache/
/data/audio_player/**/*

# Devcontainer persistent home (caches, tool state, credentials)
/.devcontainer/.home/

# IDE files exposing machine/infrastructure details (remote SDKs, deployment targets)
/.idea/deployment.xml
/.idea/webServers.xml
/.idea/misc.xml
/.idea/sshConfigs.xml
/.idea/*.iml

# Generated display test patterns (regenerate with testimage.py)
/assets/fullscreen/test*.png
